--- /dev/null
+++ b/supabase/functions/_shared/caller-auth.ts
@@ -0,0 +1,107 @@
+// Caller authentication shared by helpers.connect() and wgui-export's connect-raw.
+// Every endpoint requires a verified user JWT or a valid API key unless it opts in
+// with allowAnonymous (public game-content reads only).
+import { SupabaseClient, createClient } from '@supabase/supabase-js';
+import { jwtVerify, decodeJwt } from 'npm:jose@5.9.6';
+import { HttpError } from './http-errors.ts';
+import type { Character, PublicUser } from './content';
+
+export type CallerKind = 'user' | 'service' | 'anonymous';
+
+function jwtSecret(): string | undefined {
+  // @ts-ignore
+  return Deno.env.get('SB_JWT_SECRET') ?? Deno.env.get('JWT_SECRET') ?? undefined;
+}
+
+const AUTH_REQUIRED = () =>
+  new HttpError(401, 'Authentication required. Send a user session JWT or an API key.', 'AUTH_REQUIRED');
+
+/**
+ * Classify a non-API-key bearer token. Throws 401 for a missing/invalid token unless
+ * the endpoint allows anonymous callers (then the anon key and no token both pass).
+ */
+export async function authenticateBearer(
+  token: string,
+  allowAnonymous: boolean
+): Promise<CallerKind> {
+  if (!token) {
+    if (allowAnonymous) return 'anonymous';
+    throw AUTH_REQUIRED();
+  }
+
+  let claims: Record<string, any>;
+  const secret = jwtSecret();
+  try {
+    if (secret) {
+      ({ payload: claims } = await jwtVerify(token, new TextEncoder().encode(secret)));
+    } else {
+      throw new Error('no HS256 secret');
+    }
+  } catch {
+    // Projects on asymmetric signing keys: let GoTrue validate the session instead.
+    const unverified = (() => {
+      try {
+        return decodeJwt(token) as Record<string, any>;
+      } catch {
+        return null;
+      }
+    })();
+    if (!unverified || unverified.role !== 'authenticated') throw AUTH_REQUIRED();
+    const authClient = createClient(
+      // @ts-ignore
+      Deno.env.get('SUPABASE_URL') ?? '',
+      // @ts-ignore
+      Deno.env.get('SUPABASE_ANON_KEY') ?? ''
+    );
+    const { data, error } = await authClient.auth.getUser(token);
+    if (error || !data?.user) throw AUTH_REQUIRED();
+    return 'user';
+  }
+
+  if (claims.role === 'service_role') return 'service';
+  if (claims.role === 'authenticated' && typeof claims.sub === 'string' && claims.sub) return 'user';
+  if (allowAnonymous) return 'anonymous';
+  throw AUTH_REQUIRED();
+}
+
+/**
+ * Characters an API client may touch: granted to this client by this public user in
+ * details.api_clients.client_access, AND owned by the key's user.
+ */
+export async function grantedCharacterIds(
+  adminClient: SupabaseClient<any, 'public', any>,
+  publicUser: PublicUser,
+  apiClientId: string
+): Promise<number[]> {
+  const { data, error } = await adminClient
+    .from('character')
+    .select('id, user_id, details')
+    .eq('user_id', publicUser.user_id);
+  if (error) throw new HttpError(500, 'Failed to resolve API grants.', 'GRANT_LOOKUP_FAILED');
+  return ((data ?? []) as Character[])
+    .filter((c) =>
+      (c.details?.api_clients?.client_access ?? []).some(
+        (g: any) => g.clientId === apiClientId && g.publicUserId === `${publicUser.id}`
+      )
+    )
+    .map((c) => c.id)
+    .sort((a, b) => a - b);
+}
+
+/**
+ * Scope a character-API request body to the grant set. Returns the body to pass on,
+ * or throws 403 when a specific id is requested that is not granted.
+ */
+export function scopeBodyToGrants<T>(body: T, granted: number[], scopeList: boolean): T {
+  const b = (body ?? {}) as Record<string, any>;
+  const set = new Set(granted);
+  if (typeof b.id === 'number') {
+    if (!set.has(b.id)) throw new HttpError(403, 'You do not have access to this character', 'CHARACTER_FORBIDDEN');
+    return body;
+  }
+  if (!scopeList) return body;
+  const requested: number[] | null = Array.isArray(b.id) ? b.id.filter((x: any) => typeof x === 'number') : null;
+  const ids = requested ? requested.filter((x) => set.has(x)) : granted;
+  // fetchData treats an empty/missing id as "no filter", so never pass []: -1 matches nothing.
+  return { ...b, id: ids.length > 0 ? ids : [-1] } as T;
+}
