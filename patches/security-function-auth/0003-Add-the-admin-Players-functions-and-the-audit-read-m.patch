diff --git a/supabase/functions/admin-unlock/index.ts b/supabase/functions/admin-unlock/index.ts
new file mode 100644
index 00000000..e30d4908
--- /dev/null
+++ b/supabase/functions/admin-unlock/index.ts
@@ -0,0 +1,41 @@
+// @ts-ignore
+import { serve } from 'std/server';
+import { connect, createServiceClient } from '../_shared/helpers.ts';
+import { adminPanelPassword, issueAdminUnlockToken, requireSignedInUser, timingSafeEqualStr } from '../_shared/admin-access.ts';
+import { HttpError } from '../_shared/http-errors.ts';
+
+const MAX_FAILURES = 5;
+const WINDOW_MINUTES = 15;
+
+serve(async (req: Request) => {
+  return await connect(req, async (client, body, token) => {
+    const actor = await requireSignedInUser(client, token);
+    const expected = adminPanelPassword();
+    if (!expected) throw new HttpError(503, 'Admin panel is not configured.', 'ADMIN_NOT_CONFIGURED');
+
+    const service = createServiceClient();
+    const since = new Date(Date.now() - WINDOW_MINUTES * 60_000).toISOString();
+    const { count, error: countError } = await service
+      .from('admin_audit_log')
+      .select('id', { count: 'exact', head: true })
+      .eq('actor_user_id', actor.user_id)
+      .eq('action', 'admin_unlock_failed')
+      .gte('created_at', since);
+    if (countError) return { status: 'error', message: 'Audit log unavailable' };
+    if ((count ?? 0) >= MAX_FAILURES) {
+      throw new HttpError(429, `Too many failed attempts. Try again in ${WINDOW_MINUTES} minutes.`, 'RATE_LIMITED');
+    }
+
+    const supplied = typeof (body as any)?.password === 'string' ? ((body as any).password as string).slice(0, 256) : '';
+    const ok = supplied.length > 0 && (await timingSafeEqualStr(supplied, expected));
+    const { error: auditError } = await service.from('admin_audit_log').insert({
+      actor_user_id: actor.user_id,
+      action: ok ? 'admin_unlock' : 'admin_unlock_failed',
+      target_user_id: null,
+    });
+    if (auditError) return { status: 'error', message: 'Audit log unavailable' };
+    if (!ok) throw new HttpError(401, 'Incorrect admin password.', 'BAD_ADMIN_PASSWORD');
+
+    return { status: 'success', data: await issueAdminUnlockToken(actor.user_id) };
+  });
+});
