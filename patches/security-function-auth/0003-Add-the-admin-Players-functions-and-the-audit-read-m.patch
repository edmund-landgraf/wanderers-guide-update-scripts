diff --git a/supabase/migrations/20261026000000_admin_players.sql b/supabase/migrations/20261026000000_admin_players.sql
new file mode 100644
index 00000000..07c570f1
--- /dev/null
+++ b/supabase/migrations/20261026000000_admin_players.sql
@@ -0,0 +1,92 @@
+-- Admin Players screen (WGUI /admin -> Players tab). Fork-owned, admin-only.
+-- Read model for the admin player list plus a service-role-only audit log.
+begin;
+
+create table if not exists public.admin_audit_log (
+  id bigint generated by default as identity primary key,
+  created_at timestamptz not null default now(),
+  actor_user_id uuid not null,
+  action text not null,
+  target_user_id uuid,
+  meta jsonb
+);
+alter table public.admin_audit_log enable row level security;
+revoke all on table public.admin_audit_log from anon, authenticated;
+grant select, insert on table public.admin_audit_log to service_role;
+
+create or replace function public.admin_mask_email(p_email text)
+returns text language sql immutable set search_path = '' as $fn$
+  select case
+    when p_email is null or position('@' in p_email) = 0 then null
+    else left(split_part(p_email, '@', 1), 2) || '***@' || split_part(p_email, '@', 2)
+  end
+$fn$;
+
+create or replace function public.admin_player_overview(
+  p_limit integer default 50,
+  p_offset integer default 0,
+  p_query text default null,
+  p_tier text default null,
+  p_provider text default null
+)
+returns table (
+  user_id uuid,
+  display_name text,
+  image_url text,
+  masked_email text,
+  providers text[],
+  patreon_tier text,
+  is_capped boolean,
+  is_admin boolean,
+  is_mod boolean,
+  deactivated boolean,
+  pc_count bigint,
+  created_at timestamptz,
+  last_sign_in_at timestamptz,
+  total_count bigint
+)
+language sql stable security definer set search_path = '' as $fn$
+  with base as (
+    select
+      pu.user_id,
+      pu.display_name::text as display_name,
+      pu.image_url::text as image_url,
+      public.admin_mask_email(u.email::text) as masked_email,
+      coalesce((select array_agg(distinct i.provider order by i.provider) from auth.identities i where i.user_id = pu.user_id), '{}') as providers,
+      nullif(pu.patreon ->> 'tier', '') as patreon_tier,
+      not (
+        coalesce(pu.patreon ->> 'tier', '') in ('WANDERER', 'LEGEND', 'GAME-MASTER')
+        or coalesce(pu.patreon -> 'game_master' -> 'virtual_tier' ->> 'game_master_user_id', '') <> ''
+        or coalesce(pu.is_community_paragon, false)
+        or coalesce(pu.is_developer, false)
+      ) as is_capped,
+      pu.is_admin,
+      pu.is_mod,
+      pu.deactivated,
+      (select count(*) from public."character" c where c.user_id = pu.user_id) as pc_count,
+      pu.created_at,
+      u.last_sign_in_at
+    from public.public_user pu
+    left join auth.users u on u.id = pu.user_id
+  ), filtered as (
+    select * from base b
+    where (p_query is null or p_query = ''
+           or b.display_name ilike '%' || p_query || '%'
+           or b.user_id::text = p_query
+           or exists (select 1 from auth.users u2 where u2.id = b.user_id and u2.email ilike '%' || p_query || '%'))
+      and (p_tier is null or p_tier = '' or (p_tier = 'NONE' and b.patreon_tier is null) or b.patreon_tier = p_tier)
+      and (p_provider is null or p_provider = '' or p_provider = any(b.providers))
+  )
+  select f.*, count(*) over () as total_count
+  from filtered f
+  order by f.created_at desc, f.user_id
+  limit greatest(1, least(coalesce(p_limit, 50), 100))
+  offset greatest(0, coalesce(p_offset, 0))
+$fn$;
+
+revoke all on function public.admin_player_overview(integer, integer, text, text, text) from public, anon, authenticated;
+grant execute on function public.admin_player_overview(integer, integer, text, text, text) to service_role;
+revoke all on function public.admin_mask_email(text) from public, anon, authenticated;
+grant execute on function public.admin_mask_email(text) to service_role;
+
+commit;
