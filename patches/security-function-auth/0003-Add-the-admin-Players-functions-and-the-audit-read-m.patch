+// @ts-ignore
+import { serve } from 'std/server';
+import { connect, createServiceClient } from '../_shared/helpers.ts';
+import { requireUnlockedAdmin } from '../_shared/admin-access.ts';
+
+const SORTABLE = new Set(['name', 'email', 'login', 'tier', 'pcs', 'campaigns', 'last_login']);
+
+serve(async (req: Request) => {
+  return await connect(req, async (client, body, token) => {
+    await requireUnlockedAdmin(client, token, body);
+    const { page, page_size, query, tier, provider, sort, direction } = (body ?? {}) as {
+      sort?: string;
+      direction?: string;
+      page?: number;
+      page_size?: number;
+      query?: string;
+      tier?: string;
+      provider?: string;
+    };
+    const size = Math.min(Math.max(Number(page_size) || 50, 1), 100);
+    const pageNum = Math.max(Number(page) || 0, 0);
+
+    const { data, error } = await createServiceClient().rpc('admin_player_overview', {
+      p_limit: size,
+      p_offset: pageNum * size,
+      p_query: typeof query === 'string' ? query.trim().slice(0, 200) : null,
+      p_tier: typeof tier === 'string' ? tier : null,
+      p_provider: typeof provider === 'string' ? provider : null,
+      p_sort: typeof sort === 'string' && SORTABLE.has(sort) ? sort : null,
+      p_dir: direction === 'desc' ? 'desc' : 'asc',
+    });
+    if (error) {
+      return { status: 'error', message: 'Failed to load players' };
+    }
+    const rows = (data ?? []) as Array<Record<string, any>>;
+    return {
+      status: 'success',
+      data: {
+        page: pageNum,
+        page_size: size,
+        total: rows.length > 0 ? Number(rows[0].total_count) : 0,
+        players: rows.map(({ total_count, ...rest }) => rest),
+      },
+    };
+  });
+});
