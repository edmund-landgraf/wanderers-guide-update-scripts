@@ -0,0 +1,30 @@
+// @ts-ignore
+import { serve } from 'std/server';
+import { connect, createServiceClient } from '../_shared/helpers.ts';
+import { requireUnlockedAdmin } from '../_shared/admin-access.ts';
+import { HttpError } from '../_shared/http-errors.ts';
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+serve(async (req: Request) => {
+  return await connect(req, async (client, body, token) => {
+    // Email reveal is admin-only even if moderators are allowed on the screens (Decision D4).
+    const actor = await requireUnlockedAdmin(client, token, body);
+    const { user_id } = (body ?? {}) as { user_id?: string };
+    if (!user_id || !UUID.test(user_id)) throw new HttpError(400, 'user_id must be a uuid', 'INVALID_REQUEST');
+
+    const service = createServiceClient();
+    const { data, error } = await service.auth.admin.getUserById(user_id);
+    if (error || !data?.user) throw new HttpError(404, 'User not found', 'NOT_FOUND');
+
+    // Audit first; fail closed if the audit row can't be written.
+    const { error: auditError } = await service.from('admin_audit_log').insert({
+      actor_user_id: actor.user_id,
+      action: 'reveal_email',
+      target_user_id: user_id,
+    });
+    if (auditError) return { status: 'error', message: 'Audit log unavailable' };
+
+    return { status: 'success', data: { user_id, email: data.user.email ?? null } };
+  });
+});
