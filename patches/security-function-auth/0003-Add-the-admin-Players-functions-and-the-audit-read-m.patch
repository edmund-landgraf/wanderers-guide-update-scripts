+-- Admin Players: add campaign_count + whitelisted server-side sorting (p_sort/p_dir).
+begin;
+
+drop function if exists public.admin_player_overview(integer, integer, text, text, text);
+
+create function public.admin_player_overview(
+  p_limit integer default 50,
+  p_offset integer default 0,
+  p_query text default null,
+  p_tier text default null,
+  p_provider text default null,
+  p_sort text default null,
+  p_dir text default null
+)
+returns table (
+  user_id uuid,
+  display_name text,
+  image_url text,
+  masked_email text,
+  providers text[],
+  patreon_tier text,
+  is_capped boolean,
+  is_admin boolean,
+  is_mod boolean,
+  deactivated boolean,
+  pc_count bigint,
+  campaign_count bigint,
+  created_at timestamptz,
+  last_sign_in_at timestamptz,
+  total_count bigint
+)
+language sql stable security definer set search_path = '' as $fn$
+  with base as (
+    select
+      pu.user_id,
+      pu.display_name::text as display_name,
+      pu.image_url::text as image_url,
+      public.admin_mask_email(u.email::text) as masked_email,
+      coalesce((select array_agg(distinct i.provider order by i.provider) from auth.identities i where i.user_id = pu.user_id), '{}') as providers,
+      nullif(pu.patreon ->> 'tier', '') as patreon_tier,
+      not (
+        coalesce(pu.patreon ->> 'tier', '') in ('WANDERER', 'LEGEND', 'GAME-MASTER')
+        or coalesce(pu.patreon -> 'game_master' -> 'virtual_tier' ->> 'game_master_user_id', '') <> ''
+        or coalesce(pu.is_community_paragon, false)
+        or coalesce(pu.is_developer, false)
+      ) as is_capped,
+      pu.is_admin,
+      pu.is_mod,
+      pu.deactivated,
+      (select count(*) from public."character" c where c.user_id = pu.user_id) as pc_count,
+      (select count(*) from public.campaign cp where cp.user_id = pu.user_id) as campaign_count,
+      pu.created_at,
+      u.last_sign_in_at
+    from public.public_user pu
+    left join auth.users u on u.id = pu.user_id
+  ), filtered as (
+    select * from base b
+    where (p_query is null or p_query = ''
+           or b.display_name ilike '%' || p_query || '%'
+           or b.user_id::text = p_query
+           or exists (select 1 from auth.users u2 where u2.id = b.user_id and u2.email ilike '%' || p_query || '%'))
+      and (p_tier is null or p_tier = '' or (p_tier = 'NONE' and b.patreon_tier is null) or b.patreon_tier = p_tier)
+      and (p_provider is null or p_provider = '' or p_provider = any(b.providers))
+  )
+  select f.*, count(*) over () as total_count
+  from filtered f
+  order by
+    -- Whitelisted sort keys only; anything else falls back to created_at desc. No dynamic SQL.
+    case when lower(coalesce(p_dir, 'asc')) <> 'desc' then case p_sort
+      when 'name' then lower(f.display_name) when 'email' then lower(f.masked_email)
+      when 'login' then array_to_string(f.providers, ',') when 'tier' then f.patreon_tier end end asc nulls last,
+    case when lower(coalesce(p_dir, 'asc')) = 'desc' then case p_sort
+      when 'name' then lower(f.display_name) when 'email' then lower(f.masked_email)
+      when 'login' then array_to_string(f.providers, ',') when 'tier' then f.patreon_tier end end desc nulls last,
+    case when lower(coalesce(p_dir, 'asc')) <> 'desc' then case p_sort
+      when 'pcs' then f.pc_count when 'campaigns' then f.campaign_count end end asc nulls last,
+    case when lower(coalesce(p_dir, 'asc')) = 'desc' then case p_sort
+      when 'pcs' then f.pc_count when 'campaigns' then f.campaign_count end end desc nulls last,
+    case when p_sort = 'last_login' and lower(coalesce(p_dir, 'asc')) <> 'desc' then f.last_sign_in_at end asc nulls last,
+    case when p_sort = 'last_login' and lower(coalesce(p_dir, 'asc')) = 'desc' then f.last_sign_in_at end desc nulls last,
+    f.created_at desc, f.user_id
+  limit greatest(1, least(coalesce(p_limit, 50), 100))
+  offset greatest(0, coalesce(p_offset, 0))
+$fn$;
+
+revoke all on function public.admin_player_overview(integer, integer, text, text, text, text, text) from public, anon, authenticated;
+grant execute on function public.admin_player_overview(integer, integer, text, text, text, text, text) to service_role;
+commit;
