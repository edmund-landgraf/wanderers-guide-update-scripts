+// @ts-ignore
+import { serve } from 'std/server';
+import { connect, createServiceClient } from '../_shared/helpers.ts';
+import { requireUnlockedAdmin } from '../_shared/admin-access.ts';
+import { HttpError } from '../_shared/http-errors.ts';
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+serve(async (req: Request) => {
+  return await connect(req, async (client, body, token) => {
+    await requireUnlockedAdmin(client, token, body);
+    const { user_id } = (body ?? {}) as { user_id?: string };
+    if (!user_id || !UUID.test(user_id)) throw new HttpError(400, 'user_id must be a uuid', 'INVALID_REQUEST');
+
+    // Owned PCs only (Decision D1).
+    const { data, error } = await createServiceClient()
+      .from('character')
+      .select('id, user_id, name, level, campaign_id, updated_at, details')
+      .eq('user_id', user_id)
+      .order('updated_at', { ascending: false });
+    if (error) return { status: 'error', message: 'Failed to load characters' };
+
+    const characters = (data ?? []).map((c: any) => ({
+      id: c.id,
+      user_id: c.user_id,
+      name: c.name,
+      level: c.level,
+      campaign_id: c.campaign_id,
+      updated_at: c.updated_at,
+      ancestry: c.details?.ancestry?.name ?? null,
+      heritage: c.details?.heritage?.name ?? null,
+      background: c.details?.background?.name ?? null,
+      class: c.details?.class?.name ?? null,
+      class_2: c.details?.class_2?.name ?? null,
+      image_url: c.details?.image_url ?? null,
+    }));
+    return { status: 'success', data: characters };
+  });
+});
