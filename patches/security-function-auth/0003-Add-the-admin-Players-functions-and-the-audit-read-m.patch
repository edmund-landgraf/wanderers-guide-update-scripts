--- /dev/null
+++ b/supabase/functions/admin-get-character/index.ts
@@ -0,0 +1,37 @@
+// @ts-ignore
+import { serve } from 'std/server';
+import { connect, createServiceClient } from '../_shared/helpers.ts';
+import { requireUnlockedAdmin } from '../_shared/admin-access.ts';
+import { HttpError } from '../_shared/http-errors.ts';
+
+serve(async (req: Request) => {
+  return await connect(req, async (client, body, token) => {
+    await requireUnlockedAdmin(client, token, body);
+    const id = Number((body as { character_id?: number })?.character_id);
+    if (!Number.isInteger(id) || id <= 0) throw new HttpError(400, 'character_id must be a positive integer', 'INVALID_REQUEST');
+
+    const service = createServiceClient();
+    const { data: c, error } = await service
+      .from('character')
+      .select('id, user_id, name, level, experience, hp_current, hp_temp, hero_points, campaign_id, created_at, updated_at, details, inventory, notes, spells, companions')
+      .eq('id', id)
+      .maybeSingle();
+    if (error) return { status: 'error', message: 'Failed to load character' };
+    if (!c) throw new HttpError(404, 'Character not found', 'NOT_FOUND');
+
+    const { data: owner } = await service
+      .from('public_user')
+      .select('display_name')
+      .eq('user_id', (c as any).user_id)
+      .maybeSingle();
+    let campaign_name: string | null = null;
+    if ((c as any).campaign_id) {
+      const { data: camp } = await service.from('campaign').select('name').eq('id', (c as any).campaign_id).maybeSingle();
+      campaign_name = (camp as any)?.name ?? null;
+    }
+    return {
+      status: 'success',
+      data: { character: c, owner_display_name: (owner as any)?.display_name ?? null, campaign_name },
+    };
+  });
+});
