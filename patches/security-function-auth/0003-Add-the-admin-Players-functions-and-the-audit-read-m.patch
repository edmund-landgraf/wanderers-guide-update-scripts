diff --git a/supabase/functions/_shared/admin-access.ts b/supabase/functions/_shared/admin-access.ts
new file mode 100644
index 00000000..c4f4aca8
--- /dev/null
+++ b/supabase/functions/_shared/admin-access.ts
@@ -0,0 +1,95 @@
+import type { SupabaseClient } from '@supabase/supabase-js';
+import { getPublicUser } from './helpers.ts';
+import { HttpError } from './http-errors.ts';
+
+/**
+ * Admin screens (WGUI /admin -> Players). The admin password is the ONLY admin gate: there is
+ * no is_admin / staff check. The caller must still be a signed-in, non-deactivated account so
+ * unlock tokens can be bound to a user id and failures can be rate-limited and audited.
+ */
+export async function requireSignedInUser(client: SupabaseClient<any, 'public', any>, token: string) {
+  const user = await getPublicUser(client, token, { rejectAnonymous: true });
+  if (!user || user.deactivated) {
+    throw new HttpError(401, 'Sign in to use the admin panel.', 'AUTH_REQUIRED');
+  }
+  return user;
+}
+// ---- Admin panel password unlock ---------------------------------------------------------
+// The password lives only in the functions env (ADMIN_PANEL_PASSWORD). Unlock tokens are
+// HMAC-signed with a key derived from JWT_SECRET + the password, so changing the password
+// invalidates every outstanding token. Tokens are bound to the signed-in user's id.
+
+export const ADMIN_UNLOCK_TTL_SECONDS = 8 * 60 * 60;
+const enc = new TextEncoder();
+
+function b64url(bytes: Uint8Array): string {
+  let s = '';
+  for (const b of bytes) s += String.fromCharCode(b);
+  return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+/** Constant-time comparison of two strings (compares SHA-256 digests so length leaks nothing). */
+export async function timingSafeEqualStr(a: string, b: string): Promise<boolean> {
+  const [da, db] = await Promise.all([
+    crypto.subtle.digest('SHA-256', enc.encode(a)),
+    crypto.subtle.digest('SHA-256', enc.encode(b)),
+  ]);
+  const x = new Uint8Array(da);
+  const y = new Uint8Array(db);
+  let diff = 0;
+  for (let i = 0; i < x.length; i++) diff |= x[i] ^ y[i];
+  return diff === 0;
+}
+
+export function adminPanelPassword(): string | null {
+  // @ts-ignore Deno global
+  const value = (Deno.env.get('ADMIN_PANEL_PASSWORD') ?? '').trim();
+  return value.length > 0 ? value : null;
+}
+
+async function unlockKey(): Promise<CryptoKey> {
+  const password = adminPanelPassword();
+  // @ts-ignore Deno global
+  const jwtSecret = Deno.env.get('JWT_SECRET') ?? '';
+  if (!password || !jwtSecret) throw new HttpError(503, 'Admin panel is not configured.', 'ADMIN_NOT_CONFIGURED');
+  const base = await crypto.subtle.importKey('raw', enc.encode(jwtSecret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
+  const derived = new Uint8Array(await crypto.subtle.sign('HMAC', base, enc.encode(`admin-unlock-v1:${password}`)));
+  return crypto.subtle.importKey('raw', derived, { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
+}
+
+async function sign(payload: string): Promise<string> {
+  return b64url(new Uint8Array(await crypto.subtle.sign('HMAC', await unlockKey(), enc.encode(payload))));
+}
+
+export async function issueAdminUnlockToken(userId: string): Promise<{ token: string; expires_at: number }> {
+  const exp = Math.floor(Date.now() / 1000) + ADMIN_UNLOCK_TTL_SECONDS;
+  const payload = b64url(enc.encode(JSON.stringify({ sub: userId, exp, v: 1 })));
+  return { token: `${payload}.${await sign(payload)}`, expires_at: exp };
+}
+
+/** Throws 401 ADMIN_LOCKED unless `token` is a valid, unexpired unlock token for `userId`. */
+export async function requireAdminUnlock(userId: string, token: unknown) {
+  const locked = () => new HttpError(401, 'Admin panel is locked. Enter the admin password.', 'ADMIN_LOCKED');
+  if (typeof token !== 'string' || token.length > 512) throw locked();
+  const [payload, signature] = token.split('.');
+  if (!payload || !signature) throw locked();
+  if (!(await timingSafeEqualStr(signature, await sign(payload)))) throw locked();
+  let claims: { sub?: string; exp?: number };
+  try {
+    claims = JSON.parse(atob(payload.replace(/-/g, '+').replace(/_/g, '/')));
+  } catch {
+    throw locked();
+  }
+  if (claims.sub !== userId || typeof claims.exp !== 'number' || claims.exp < Date.now() / 1000) throw locked();
+}
+
+/** Signed-in user + valid unlock token (sent as body.admin_unlock; custom headers are not in the shared CORS allow-list). */
+export async function requireUnlockedAdmin(
+  client: SupabaseClient<any, 'public', any>,
+  token: string,
+  body: unknown
+) {
+  const user = await requireSignedInUser(client, token);
+  await requireAdminUnlock(user.user_id, (body as any)?.admin_unlock);
+  return user;
+}
